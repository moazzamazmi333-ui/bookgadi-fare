<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Taxi Fare Calculator</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,system-ui;
  background:#0f2027;
  padding:15px;
}
.card{
  max-width:480px;
  margin:auto;
  background:#fff;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 15px 40px rgba(0,0,0,.3);
}
#map{height:250px;width:100%}
.content{padding:15px}

input,select,button{
  width:100%;
  padding:12px;
  margin-top:10px;
  font-size:15px;
  border-radius:10px;
  border:1px solid #ddd;
}
button{cursor:pointer;border:none}

.btn-location{background:#1a73e8;color:#fff}
.btn-primary{background:#000;color:#fff}
.btn-whatsapp{background:#25D366;color:#fff}

.row{display:flex;gap:15px;margin-top:10px}
#tripOptions,#userForm,#waBtn{display:none}

.badge{
  display:inline-block;
  padding:5px 10px;
  border-radius:50px;
  font-size:12px;
  font-weight:bold;
}
.local{background:#e8f5e9;color:#2e7d32}
.outstation{background:#fff3e0;color:#e65100}

#result{margin-top:12px;font-weight:bold;line-height:1.6}
</style>
</head>

<body>

<div class="card">
  <div id="map"></div>

  <div class="content">
    <input id="pickup" placeholder="Pickup Location">
    <button class="btn-location" onclick="useMyLocation()">📍 Use My Location</button>

    <input id="drop" placeholder="Drop Location">

    <!-- 🔥 FIXED VEHICLE SELECT -->
    <select id="vehicle">
      <option value="11" selected>Hatchback</option>
      <option value="10">Sedan</option>
      <option value="12">SUV</option>
    </select>

    <div id="tripOptions" class="row">
      <label><input type="checkbox" id="oneway" checked onchange="recalculate()"> One Way</label>
      <label><input type="checkbox" id="roundtrip" onchange="recalculate()"> Round Trip</label>
    </div>

    <button class="btn-primary" onclick="calculateFare()">Check Fare</button>

    <div id="result"></div>

    <button id="waBtn" class="btn-whatsapp" onclick="openUserForm()">💬 Book on WhatsApp</button>

    <div id="userForm">
      <input id="custName" placeholder="Your Name">
      <input id="custPhone" placeholder="Mobile Number">
      <button class="btn-whatsapp" onclick="sendWhatsApp()">Send to WhatsApp</button>
    </div>
  </div>
</div>

<script>
let map, geocoder, pickupAC, dropAC, pickupPlace, dropPlace;
let lastKm = 0;

function initMap(){
  geocoder = new google.maps.Geocoder();
  map = new google.maps.Map(document.getElementById("map"),{
    center:{lat:26.0739,lng:83.1859}, zoom:7
  });

  pickupAC = new google.maps.places.Autocomplete(pickup,{componentRestrictions:{country:"in"}});
  dropAC   = new google.maps.places.Autocomplete(drop,{componentRestrictions:{country:"in"}});

  pickupAC.addListener("place_changed",()=>pickupPlace=pickupAC.getPlace());
  dropAC.addListener("place_changed",()=>dropPlace=dropAC.getPlace());
}

function useMyLocation(){
  navigator.geolocation.getCurrentPosition(pos=>{
    const latlng={lat:pos.coords.latitude,lng:pos.coords.longitude};
    map.setCenter(latlng); map.setZoom(14);
    geocoder.geocode({location:latlng},res=>{
      if(res[0]){pickup.value=res[0].formatted_address;pickupPlace=res[0];}
    });
  });
}

function getCity(place){
  let city="";
  place.address_components.forEach(c=>{
    if(c.types.includes("locality")) city=c.long_name.toLowerCase();
  });
  return city;
}

function recalculate(){
  if(pickupPlace && dropPlace) calculateFare();
}

function calculateFare(){
  if(!pickupPlace || !dropPlace){
    result.innerHTML="Pickup aur Drop select karein";
    return;
  }

  userForm.style.display="none";

  const vehicleSelect = document.getElementById("vehicle");
  const vehicleName =
    vehicleSelect.options[vehicleSelect.selectedIndex].text;
  const rate = Number(vehicleSelect.value);

  const pickupCity = getCity(pickupPlace);
  const dropCity   = getCity(dropPlace);

  new google.maps.DistanceMatrixService().getDistanceMatrix({
    origins:[pickupPlace.formatted_address],
    destinations:[dropPlace.formatted_address],
    travelMode:"DRIVING",
    unitSystem:google.maps.UnitSystem.METRIC
  },res=>{
    lastKm = res.rows[0].elements[0].distance.value/1000;
    let html="";

    if(pickupCity===dropCity){
      tripOptions.style.display="none";
      html=`<span class="badge local">Local Ride</span><br>
            Vehicle: ${vehicleName}<br>
            Package: 8Hr / 80Km<br>
            Fare: ₹1800`;
    }else{
      tripOptions.style.display="flex";
      html=`<span class="badge outstation">Outstation Ride</span><br>
            Vehicle: ${vehicleName}<br>
            Distance: ${lastKm.toFixed(1)} KM<br>`;
      if(oneway.checked)
        html+=`One Way Fare: ₹${Math.round(150+lastKm*rate)}<br>`;
      if(roundtrip.checked)
        html+=`Round Trip Fare: ₹${Math.round(lastKm*rate*2+300)}<br>`;
    }

    result.innerHTML=html;
    waBtn.style.display="block";
  });
}

function openUserForm(){
  userForm.style.display="block";
}

function sendWhatsApp(){
  if(!custName.value || !custPhone.value){
    alert("Name aur Mobile bhare");
    return;
  }

  const vehicleSelect=document.getElementById("vehicle");
  const vehicleName=vehicleSelect.options[vehicleSelect.selectedIndex].text;
  const rate=Number(vehicleSelect.value);

  let msg=`Taxi Booking
Name: ${custName.value}
Mobile: ${custPhone.value}
Vehicle: ${vehicleName}
Pickup: ${pickup.value}
Drop: ${drop.value}
Distance: ${lastKm.toFixed(1)} KM
`;

  if(getCity(pickupPlace)===getCity(dropPlace)){
    msg+=`Local Ride
Package: 8Hr / 80Km
Fare: ₹1800`;
  }else{
    if(oneway.checked)
      msg+=`One Way Fare: ₹${Math.round(150+lastKm*rate)}\n`;
    if(roundtrip.checked)
      msg+=`Round Trip Fare: ₹${Math.round(lastKm*rate*2+300)}\n`;
  }

  window.open(
    "https://wa.me/919651191446?text="+encodeURIComponent(msg),
    "_blank"
  );
}
</script>

<script
src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB8fFUPeGfUy8Wwh-mQ_d3fbGZzKBy7VwM&libraries=places&callback=initMap"
async defer></script>

</body>
</html>
